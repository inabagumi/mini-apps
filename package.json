{
  "name": "@inabagumi/mini-apps",
  "private": true,
  "description": "Mini apps by Haneru Developers.",
  "homepage": "https://github.com/inabagumi/mini-apps#readme",
  "bugs": {
    "url": "https://github.com/inabagumi/mini-apps/issues",
    "email": "contact@haneru.dev"
  },
  "license": "MIT",
  "author": {
    "name": "Haneru Developers",
    "email": "contact@haneru.dev",
    "url": "https://haneru.dev/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inabagumi/mini-apps.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "typegen": "turbo typegen"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "turbo": "2.11.13",
    "ultracite": "8.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
