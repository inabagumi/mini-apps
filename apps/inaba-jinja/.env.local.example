NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_BASE_URL=https://example.com
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

# Contentful のモックサーバー (mocks/contentful) に接続する場合は、
# 上の Contentful の設定の代わりに以下を設定してください。
# NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=mock
# NEXT_PUBLIC_CONTENTFUL_SPACE_ID=mock
# CONTENTFUL_HOST=localhost:4000
# CONTENTFUL_INSECURE=true

# Upstash Redis のモックサーバー (mocks/upstash-redis) に接続する場合は、
# 上の Upstash Redis の設定の代わりに以下を設定してください。
# UPSTASH_REDIS_REST_TOKEN=mock
# UPSTASH_REDIS_REST_URL=http://localhost:4001
