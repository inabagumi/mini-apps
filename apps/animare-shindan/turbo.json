{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": ["DATABASE_ADAPTER", "DATABASE_URL"]
    },
    "test": {
      "env": ["TEST_DATABASE_URL"],
      "inputs": ["$TURBO_EXTENDS$", "prisma/**"],
      "passThroughEnv": ["CI"]
    },
    "test:e2e": {
      "env": ["TEST_DATABASE_URL"],
      "inputs": ["$TURBO_EXTENDS$", "prisma/**"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_*"]
    }
  }
}
