datasource db {
  provider = "postgresql"
}

generator client {
  importFileExtension = "ts"
  moduleFormat        = "esm"
  output              = "../lib/generated/prisma"
  provider            = "prisma-client"
}

// The questions and the answers are shown in the ascending order of their
// positions (0 or more, which is also guaranteed by a CHECK constraint in the
// migration). The positions do not have to be consecutive or unique: the items
// with the same position are shown in the ascending order of their IDs, so the
// order is always the same for the same data. To move an item, renumber the
// positions of the items (the questions, or the answers of the question) in a
// transaction, as the seed does.
model Question {
  answers  Answer[]
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  position Int
  title    String

  @@index([position])
  @@map("questions")
}

model Answer {
  Question Question? @relation(fields: [questionId], references: [id])

  id         String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  position   Int
  questionId String?       @map("question_id") @db.Uuid
  scores     AnswerScore[]
  value      String

  @@index([questionId, position])
  @@map("answers")
}

// The score (0 to 3) that an answer adds to a result. The range of the score
// is also guaranteed by a CHECK constraint in the migration.
model AnswerScore {
  answerId String @map("answer_id") @db.Uuid
  resultId String @map("result_id") @db.Uuid
  score    Int

  answer Answer @relation(fields: [answerId], references: [id])
  result Result @relation(fields: [resultId], references: [id])

  @@id([answerId, resultId])
  @@index([resultId])
  @@map("answer_scores")
}

model Result {
  answerScores       AnswerScore[]
  attribute          String
  catchphrase        String
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  parameters         Json
  recommendedVideoId String           @map("recommended_video_id") @db.Uuid
  recommendedVideo   RecommendedVideo @relation(fields: [recommendedVideoId], references: [id])
  slug               String           @unique
  talent             Talent           @relation(fields: [talentId], references: [id])
  type               String
  talentId           String           @map("talent_id") @db.Uuid

  @@map("results")
}

model Talent {
  Result Result[]

  id      String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name    String
  twitter String?
  youtube String?

  @@map("talents")
}

model RecommendedVideo {
  Result Result[]

  id  String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  url String

  @@map("recommended_videos")
}

model Release {
  body        String
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  publishedAt DateTime @map("published_at")
  slug        String   @unique
  title       String

  @@map("releases")
}
