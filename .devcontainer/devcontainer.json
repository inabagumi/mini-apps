{
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "oxc.oxc-vscode",
        "bradlc.vscode-tailwindcss",
        "unifiedjs.vscode-mdx"
      ]
    }
  },
  "dockerComposeFile": ["../compose.yaml", "compose.yaml"],
  "forwardPorts": [3000, 3001, 3002, 3003, 3004, 4000, 4001],
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "name": "mini-apps",
  "postCreateCommand": "./.devcontainer/post-create.sh",
  "service": "app",
  "waitFor": "postCreateCommand",
  "workspaceFolder": "/workspaces/mini-apps"
}
