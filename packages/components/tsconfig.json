{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node"]
  },
  "extends": "@tsconfig/strictest/tsconfig",
  "exclude": ["dist", "node_modules"]
}
