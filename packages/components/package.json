{
  "name": "@inabagumi/components",
  "version": "1.0.0",
  "private": true,
  "description": "This is a tailwind.config for Inaba Jinja.",
  "homepage": "https://haneru.dev/",
  "bugs": {
    "url": "https://github.com/inabagumi/mini-apps/issues",
    "email": "contact@haneru.dev"
  },
  "license": "MIT",
  "author": {
    "name": "Haneru Developers",
    "email": "contact@haneru.dev",
    "url": "https://haneru.dev/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inabagumi/mini-apps.git",
    "directory": "packages/components"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "skeleton": [
        "./dist/skeleton/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton/index.d.ts",
      "import": "./dist/skeleton/index.js",
      "default": "./dist/skeleton/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@tsconfig/node20": "20.1.11",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "tsup": "9.0.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tailwind-merge": "^2.2.1"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
