{
  "name": "@inabagumi/components",
  "version": "1.0.0",
  "private": true,
  "description": "Shared React components for Haneru Developers' mini apps.",
  "homepage": "https://haneru.dev/",
  "bugs": {
    "url": "https://github.com/inabagumi/mini-apps/issues",
    "email": "contact@haneru.dev"
  },
  "license": "MIT",
  "author": {
    "name": "Haneru Developers",
    "email": "contact@haneru.dev",
    "url": "https://haneru.dev/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inabagumi/mini-apps.git",
    "directory": "packages/components"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "typesVersions": {
    "*": {
      "skeleton": [
        "./dist/skeleton/index.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./skeleton": {
      "types": "./dist/skeleton/index.d.mts",
      "import": "./dist/skeleton/index.mjs",
      "default": "./dist/skeleton/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@inabagumi/config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@tsconfig/node20": "20.1.11",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
