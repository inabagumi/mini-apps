{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".docusaurus/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "__mocks__/**",
        "app/**",
        "assets/**",
        "components/**",
        "lib/**",
        "*.ts",
        "*.tsx",
        "tsconfig.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "typegen"]
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": [
        ".docusaurus/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "dist/**"
      ]
    }
  }
}
